# MongoDB Atlas Database Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Google reCAPTCHA v2 (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your_recaptcha_site_key_here"
RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key_here"

# Admin Authentication Credentials & Session Secret
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_admin_password_here"
ADMIN_SESSION_SECRET="your_random_32_character_secret_here"

# Optional: Email Notifications (Resend API)
RESEND_API_KEY=""
SEND_TO_EMAIL="admin@example.com"
SEND_FROM_EMAIL="noreply@example.com"
